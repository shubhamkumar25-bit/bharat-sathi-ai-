# Firebase Admin Configuration
# Get these from Firebase Console → Project Settings → Service Accounts

# Option 1: Full service account JSON (recommended)
# Download service account key from Firebase Console and paste the entire JSON here
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Option 2: Individual credentials
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_service_account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"

# Firebase Storage
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Google AI API Key
# Get from https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=your_google_ai_api_key

# Data.gov.in API Configuration
# Get your API key from https://data.gov.in/user/api-key
# IMPORTANT: Never commit this key to GitHub or expose it in frontend code
DATA_GOV_API_KEY=your_data_gov_api_key
DATA_GOV_BASE_URL=https://api.data.gov.in

# Server Port (optional, defaults to 4000)
PORT=4000
